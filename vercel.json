{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/kt/(.*)", "destination": "/api/kt/[...path]" },
    { "source": "/api/shopify/(.*)", "destination": "/api/shopify/[...path]" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
