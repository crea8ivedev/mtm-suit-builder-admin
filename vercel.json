{
  "version": 2,
  "builds": [
    { "src": "api/shopify.js", "use": "@vercel/node" },
    { "src": "api/kt.js", "use": "@vercel/node" },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/shopify(.*)", "dest": "/api/shopify" },
    { "src": "/api/kt(.*)", "dest": "/api/kt" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
