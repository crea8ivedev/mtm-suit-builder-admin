{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/api/kt(?:/(.*))?$", "dest": "/api/kt-proxy?path=$1" },
    { "src": "^/api/shopify(?:/(.*))?$", "dest": "/api/shopify-proxy?path=$1" },
    { "handle": "filesystem" },
    { "src": "^(?!/api/).*", "dest": "/index.html" }
  ]
}
